@model MEH.Models.AuthPageViewModel
@using MEH.Models

@{
    ViewData["Title"] = "Online-Zugang // Anmeldung & Registrierung";
    var isRegisterTab = Model.ActiveTab == "register";
}

<!-- TOP HERO HEADER -->
<div class="text-center mb-4">
    <div class="sd-squad-tag justify-content-center">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        AUTHENTICATION GATEWAY // SECURE ACCESS
    </div>
    <h1 class="sd-hero-titel mb-1">ServiceDesk <em>Online-Zugang</em></h1>
    <p class="sd-hero-unter">Sicherer Zugriff auf das zentrale Support- &amp; Ticketmanagementsystem.</p>
</div>

<!-- AUTH CARD CONTAINER -->
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="sd-join-card p-4 p-sm-5">

            <!-- 2-OPTION TAB SWITCHER (ANMELDUNG / REGISTRIERUNG) -->
            <div class="d-flex p-1 rounded mb-4" style="background: rgba(11, 15, 28, 0.7); border: 1px solid rgba(255, 255, 255, 0.08);">
                <button type="button" id="tabBtnLogin" class="btn flex-grow-1 text-center py-2 fw-semibold border-0 rounded transition-all @(!isRegisterTab ? "bg-primary text-white shadow-sm" : "text-secondary")" onclick="switchTab('login')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Anmeldung
                </button>
                <button type="button" id="tabBtnRegister" class="btn flex-grow-1 text-center py-2 fw-semibold border-0 rounded transition-all @(isRegisterTab ? "bg-primary text-white shadow-sm" : "text-secondary")" onclick="switchTab('register')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                    Registrierung
                </button>
            </div>

            <!-- ================= OPTION 1: ANMELDUNG (LOGIN) ================= -->
            <div id="paneLogin" style="display: @(!isRegisterTab ? "block" : "none");">
                
                <div class="mb-3">
                    <div class="sd-join-kicker">BESTEHENDES KONTO</div>
                    <h2 class="sd-join-title fs-5 mb-1">Im System anmelden</h2>
                    <p class="sd-join-text mb-0">Melde dich mit deinen Zugangsdaten an, um Tickets zu bearbeiten.</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="mb-3">
                        <label asp-for="Login.Email" class="sd-input-label">E-MAIL-ADRESSE</label>
                        <input asp-for="Login.Email" type="email" class="sd-glass-input" placeholder="name@servicedesk.de" autofocus />
                        <span asp-validation-for="Login.Email" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Login.Password" class="sd-input-label">PASSWORT</label>
                        <input asp-for="Login.Password" type="password" class="sd-glass-input" placeholder="••••••••" />
                        <span asp-validation-for="Login.Password" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="Login.RememberMe" class="form-check-input" />
                            <label asp-for="Login.RememberMe" class="form-check-label small text-secondary">
                                Eingeloggt bleiben
                            </label>
                        </div>
                        <a href="javascript:void(0)" onclick="alert('Bitte wende dich an die IT-Administration in Dortmund, um dein Passwort zurückzusetzen.');" class="sd-subtle-link small" style="font-size: 0.8rem;">
                            Passwort vergessen?
                        </a>
                    </div>

                    <button type="submit" class="sd-btn-submit-crew w-100 py-2 fs-6">
                        Anmelden &amp; Zugriff freischalten &rarr;
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-secondary small">Noch kein Benutzerkonto?</span>
                    <a href="javascript:void(0)" onclick="switchTab('register')" class="text-info small fw-bold ms-1">
                        Jetzt neu registrieren
                    </a>
                </div>
            </div>

            <!-- ================= OPTION 2: REGISTRIERUNG (REGISTER) ================= -->
            <div id="paneRegister" style="display: @(isRegisterTab ? "block" : "none");">
                
                <div class="mb-3">
                    <div class="sd-join-kicker">NEUZUGANG</div>
                    <h2 class="sd-join-title fs-5 mb-1">Neuen Account registrieren</h2>
                    <p class="sd-join-text mb-0">Erstelle ein Profil. Die Daten werden direkt in der Datenbank gespeichert.</p>
                </div>

                <form asp-action="RegisterSubmit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="Register.Vorname" class="sd-input-label">VORNAME *</label>
                            <input asp-for="Register.Vorname" class="sd-glass-input" placeholder="z. B. Anna" />
                            <span asp-validation-for="Register.Vorname" class="text-danger small fw-semibold"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Register.Nachname" class="sd-input-label">NACHNAME *</label>
                            <input asp-for="Register.Nachname" class="sd-glass-input" placeholder="z. B. Schmidt" />
                            <span asp-validation-for="Register.Nachname" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Email" class="sd-input-label">E-MAIL-ADRESSE *</label>
                        <input asp-for="Register.Email" type="email" class="sd-glass-input" placeholder="anna.schmidt@servicedesk.de" />
                        <span asp-validation-for="Register.Email" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Fachbereich" class="sd-input-label">FACHBEREICH / SPEZIALISIERUNG *</label>
                        <select asp-for="Register.Fachbereich" class="sd-glass-input">
                            <option value="IT-Support">IT-Support &amp; Helpdesk</option>
                            <option value="Netzwerk">Netzwerk &amp; Infrastruktur</option>
                            <option value="Hardware">Hardware &amp; Clients</option>
                            <option value="Software">Software &amp; Cloud</option>
                            <option value="Sicherheit">IT-Sicherheit &amp; Berechtigungen</option>
                        </select>
                        <span asp-validation-for="Register.Fachbereich" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label asp-for="Register.Password" class="sd-input-label">PASSWORT *</label>
                            <input asp-for="Register.Password" type="password" class="sd-glass-input" placeholder="Mind. 4 Zeichen" />
                            <span asp-validation-for="Register.Password" class="text-danger small fw-semibold"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Register.ConfirmPassword" class="sd-input-label">BESTÄTIGEN *</label>
                            <input asp-for="Register.ConfirmPassword" type="password" class="sd-glass-input" placeholder="Wiederholen" />
                            <span asp-validation-for="Register.ConfirmPassword" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <!-- DATABASE NOTICE SHIELD -->
                    <div class="sd-ref-shield mb-4">
                        <div class="sd-shield-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                            </svg>
                        </div>
                        <div class="small">
                            <div class="fw-bold text-white mb-1">Direkte Datenbank-Speicherung</div>
                            <div class="text-secondary" style="font-size: 0.78rem;">
                                Dein Account wird sofort in der Datenbank persistiert und du wirst automatisch eingeloggt.
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="sd-btn-submit-crew w-100 py-2 fs-6">
                        Registrieren &amp; Einloggen &rarr;
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-secondary small">Du hast bereits ein Konto?</span>
                    <a href="javascript:void(0)" onclick="switchTab('login')" class="text-info small fw-bold ms-1">
                        Hier anmelden
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function switchTab(tab) {
            const paneLogin = document.getElementById('paneLogin');
            const paneRegister = document.getElementById('paneRegister');
            const tabBtnLogin = document.getElementById('tabBtnLogin');
            const tabBtnRegister = document.getElementById('tabBtnRegister');

            if (tab === 'register') {
                paneLogin.style.display = 'none';
                paneRegister.style.display = 'block';

                tabBtnRegister.classList.add('bg-primary', 'text-white', 'shadow-sm');
                tabBtnRegister.classList.remove('text-secondary');

                tabBtnLogin.classList.remove('bg-primary', 'text-white', 'shadow-sm');
                tabBtnLogin.classList.add('text-secondary');
            } else {
                paneRegister.style.display = 'none';
                paneLogin.style.display = 'block';

                tabBtnLogin.classList.add('bg-primary', 'text-white', 'shadow-sm');
                tabBtnLogin.classList.remove('text-secondary');

                tabBtnRegister.classList.remove('bg-primary', 'text-white', 'shadow-sm');
                tabBtnRegister.classList.add('text-secondary');
            }
        }
    </script>
}
