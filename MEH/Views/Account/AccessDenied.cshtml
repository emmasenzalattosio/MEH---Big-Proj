@{
    ViewData["Title"] = "Zugriff verweigert // Access Denied";
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <div class="sd-squad-tag text-danger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            SICHERHEITSSYSTEM // AUTHENTIFIZIERUNG
        </div>
        <h1 class="sd-hero-titel mb-1">Zugriff <span class="text-danger">verweigert</span></h1>
        <p class="sd-hero-unter mb-0">Du besitzt für diesen Bereich nicht die erforderlichen Berechtigungen.</p>
    </div>
    <a asp-controller="Ticket" asp-action="Index" class="sd-btn-outline-action">
        &larr; Zurück zur Übersicht
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="sd-join-card" style="border-color: rgba(239, 68, 68, 0.3);">
            
            <div class="sd-danger-shield mb-4">
                <div class="sd-danger-shield-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                </div>
                <div>
                    <div class="fw-bold text-white mb-1">Fehlende Berechtigung</div>
                    <div class="text-secondary small">
                        Dein aktueller Benutzeraccount verfügt nicht über die erforderliche Rolle, um auf diese Ressource zuzugreifen. Bitte wende dich an einen Administrator oder melde dich mit einem entsprechenden Account an.
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2">
                <a asp-controller="Account" asp-action="Login" class="sd-btn-outline-action">
                    Mit anderem Account anmelden
                </a>
                <a asp-controller="Ticket" asp-action="Index" class="sd-btn-submit-crew">
                    Zum Dashboard &rarr;
                </a>
            </div>

        </div>
    </div>
</div>
