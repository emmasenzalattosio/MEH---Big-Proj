@model MEH.Models.Kategorie

@{
    ViewData["Title"] = "Neue Kategorie";
}

<div class="sd-kopf">
    <div>
        <div class="sd-label">Seite 05 // Views/Kategorie/Create.cshtml</div>
        <h1 class="sd-seiten-titel">Neue <em>Kategorie</em></h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">&lt; Zurück zur Übersicht</a>
</div>

<div class="sd-formular">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name" class="form-label">Name der Kategorie *</label>
            <input asp-for="Name" class="form-control" placeholder="z. B. Telefonie" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Beschreibung" class="form-label">Kurzbeschreibung</label>
            <textarea asp-for="Beschreibung" class="form-control" rows="3" placeholder="Wofür wird diese Kategorie genutzt?"></textarea>
            <span asp-validation-for="Beschreibung" class="text-danger"></span>
        </div>

        <div class="sd-formular-aktionen">
            <a asp-action="Index" class="btn btn-outline-dark">Abbrechen</a>
            <button type="submit" class="btn btn-dark">Kategorie speichern &gt;</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
