@model MEH.Models.Kategorie

@{
    ViewData["Title"] = "Kategorie löschen // " + Model.Name;
    bool hasTickets = Model.Tickets.Any();
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <div class="sd-squad-tag text-danger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            SICHERHEITSABFRAGE // 1:N REFERENZSCHUTZ
        </div>
        <h1 class="sd-hero-titel mb-1">Kategorie <span class="text-danger">löschen?</span></h1>
        <p class="sd-hero-unter mb-0">Überprüfung der Datenbank-Integrität für Themenbereich <strong>@Model.Name</strong></p>
    </div>
    <a asp-action="Index" class="sd-btn-outline-action">
        &larr; Zurück zur Übersicht
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="sd-join-card" style="border-color: rgba(239, 68, 68, 0.3);">
            
            @if (hasTickets)
            {
                <div class="sd-danger-shield mb-4">
                    <div class="sd-danger-shield-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </div>
                    <div>
                        <div class="fw-bold text-white mb-1">1:n Referenzschutz aktiv – Löschen blockiert</div>
                        <div class="text-secondary small">
                            Dieser Kategorie sind aktuell noch <strong>@Model.Tickets.Count Ticket(s)</strong> zugeordnet. Um Inkonsistenzen und verwaiste Datensätze zu verhindern, lehnt die Datenbank das Löschen ab. Bitte weisen Sie die betroffenen Tickets zuerst einer anderen Kategorie zu.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="sd-danger-shield mb-4">
                    <div class="sd-danger-shield-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                    </div>
                    <div>
                        <div class="fw-bold text-white mb-1">Unwiderruflicher Löschvorgang</div>
                        <div class="text-secondary small">
                            Diese Kategorie besitzt keine verknüpften Tickets und kann dauerhaft entfernt werden.
                        </div>
                    </div>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6">
                    <div class="sd-detail-item">
                        <div class="sd-detail-label">KATEGORIE-NAME</div>
                        <div class="sd-detail-value fs-5 text-white">@Model.Name</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="sd-detail-item">
                        <div class="sd-detail-label">VERKNÜPFTE TICKETS</div>
                        <div class="sd-detail-value font-monospace @(hasTickets ? "text-danger" : "text-success") fs-5">
                            @Model.Tickets.Count Tickets
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="sd-detail-item">
                        <div class="sd-detail-label">BESCHREIBUNG</div>
                        <div class="sd-detail-value text-secondary">
                            @(string.IsNullOrWhiteSpace(Model.Beschreibung) ? "– keine Beschreibung –" : Model.Beschreibung)
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center pt-2">
                <input type="hidden" asp-for="ID" />
                <a asp-action="Index" class="sd-btn-outline-action">
                    Abbrechen
                </a>
                <button type="submit" class="sd-btn-danger-action">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                    Endgültig löschen
                </button>
            </form>

        </div>
    </div>
</div>
