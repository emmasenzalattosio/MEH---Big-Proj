@model MEH.Models.Kategorie

@{
    ViewData["Title"] = "Kategorie löschen";
}

<div class="sd-kopf">
    <div>
        <div class="sd-label">Seite 05 // KAT-@Model.ID.ToString("00")</div>
        <h1 class="sd-seiten-titel">Kategorie <em>löschen?</em></h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">&lt; Zurück zur Übersicht</a>
</div>

<div class="sd-formular">
    <div class="sd-hinweis mb-4">
        <div class="sd-label sd-label-akzent">■ Datenbank-Regel // 1:n Referenzschutz</div>
        <p class="mb-0 mt-2">Kategorien, denen noch Tickets zugeordnet sind, können nicht gelöscht werden.
            @if (Model.Tickets.Any())
            {
                <br /><strong>Dieser Kategorie sind noch @Model.Tickets.Count Ticket(s) zugeordnet – das Löschen wird abgelehnt.</strong>
            }
        </p>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Kurzbeschreibung</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Beschreibung) ? "–" : Model.Beschreibung)</dd>
    </dl>

    <form asp-action="Delete" class="sd-formular-aktionen">
        <input type="hidden" asp-for="ID" />
        <a asp-action="Index" class="btn btn-outline-dark">Abbrechen</a>
        <button type="submit" class="btn btn-dark">Endgültig löschen</button>
    </form>
</div>
