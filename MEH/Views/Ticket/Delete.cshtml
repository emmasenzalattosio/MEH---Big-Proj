@model MEH.Models.Ticket

@{
    ViewData["Title"] = "Ticket löschen";
}

<div class="sd-kopf">
    <div>
        <div class="sd-label">Seite 02 // @Model.Nummer()</div>
        <h1 class="sd-seiten-titel">Ticket <em>löschen?</em></h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">&lt; Zurück zur Liste</a>
</div>

<div class="sd-formular">
    <div class="sd-hinweis mb-4">
        <div class="sd-label sd-label-akzent">■ Achtung</div>
        <p class="mb-0 mt-2">Das Ticket wird endgültig aus der Datenbank entfernt.</p>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Titel</dt>
        <dd class="col-sm-9">@Model.Titel</dd>
        <dt class="col-sm-3">Kategorie</dt>
        <dd class="col-sm-9">@(Model.Kategorie?.Name ?? "–")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="sd-badge @Model.Status.BadgeKlasse()">@Model.Status.Anzeige()</span></dd>
        <dt class="col-sm-3">Zuständig</dt>
        <dd class="col-sm-9">@(Model.Mitarbeiter?.Name ?? "– nicht zugewiesen –")</dd>
    </dl>

    <form asp-action="Delete" class="sd-formular-aktionen">
        <input type="hidden" asp-for="ID" />
        <a asp-action="Index" class="btn btn-outline-dark">Abbrechen</a>
        <button type="submit" class="btn btn-dark">Endgültig löschen</button>
    </form>
</div>
