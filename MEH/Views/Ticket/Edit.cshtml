@model MEH.Models.Ticket
@using MEH.Models

@{
    ViewData["Title"] = "Ticket bearbeiten // " + Model.Nummer();
    // Geschäftsregel: Abgeschlossene Tickets sind gesperrt, bis sie wieder geöffnet werden
    bool gesperrt = Model.Status == TicketStatus.Schluss;
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <div class="sd-squad-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            TICKET BEARBEITUNG // @Model.Nummer()
        </div>
        <h1 class="sd-hero-titel mb-1">Ticket bearbeiten</h1>
        <p class="sd-hero-unter mb-0">Erstellt am @Model.ErstelltAm.ToString("dd.MM.yyyy HH:mm") &middot; @(Model.Kategorie?.Name ?? "Ohne Kategorie")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.ID" class="sd-btn-outline-action">
            Details ansehen &rarr;
        </a>
        <a asp-action="Index" class="sd-btn-outline-action">
            &larr; Zurück zur Übersicht
        </a>
    </div>
</div>

<!-- 2-COLUMN LAYOUT -->
<div class="row g-4">
    <!-- LEFT SIDE: PROTOKOLL & GESCHÄFTSREGEL -->
    <div class="col-12 col-lg-4">
        <div class="sd-crew-card mb-3">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="sd-join-icon" style="width: 32px; height: 32px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                </div>
                <h3 class="sd-crew-name mb-0 fs-5">Bearbeitungs-Protokoll</h3>
            </div>
            
            <p class="small text-secondary mb-3">
                Erst beschreiben, dann fluchen. Je genauer die Fehleranalyse, desto zielgerichteter kann das Ticket gelöst werden.
            </p>

            <div class="sd-ref-shield mb-3">
                <div class="sd-shield-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <div class="small">
                    <div class="fw-bold text-white mb-1">Geschäftsregel Schreibschutz</div>
                    <div class="text-secondary" style="font-size: 0.8rem;">
                        Abgeschlossene Tickets sind vor versehentlichen Änderungen geschützt und müssen zur Bearbeitung explizit wieder geöffnet werden.
                    </div>
                </div>
            </div>

            @if (gesperrt)
            {
                <div class="mt-2">
                    <form asp-action="WiederOeffnen" asp-route-id="@Model.ID" method="post">
                        <button type="submit" class="sd-btn-warning-action w-100 justify-content-center">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                                <path d="M21 3v5h-5"/>
                                <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                                <path d="M3 21v-5h5"/>
                            </svg>
                            Ticket wieder öffnen &amp; entsperren
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 small text-success font-monospace">
                    <span class="sd-dot-pulse"></span>
                    <span>TICKET IST AKTIV BEARBEITBAR</span>
                </div>
            }

            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 small font-monospace text-muted d-flex justify-content-between">
                <span>SYSTEM-STATUS:</span>
                <span class="sd-badge @Model.Status.BadgeKlasse()">@Model.Status.Anzeige()</span>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE: THE EDIT FORM -->
    <div class="col-12 col-lg-8">
        <div class="sd-join-card">
            @if (gesperrt)
            {
                <div class="sd-lock-card mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="sd-shield-icon text-warning">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </div>
                        <div>
                            <div class="text-white fw-bold">Ticket ist abgeschlossen (Schreibgeschützt)</div>
                            <div class="text-secondary small">Um Felder zu bearbeiten, reaktiviere das Ticket über den linken Button.</div>
                        </div>
                    </div>
                </div>
            }

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="sd-flash sd-flash-fehler"></div>
                <input type="hidden" asp-for="ID" />
                <input type="hidden" asp-for="ErstelltAm" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" />

                <fieldset disabled="@gesperrt">
                    <div class="mb-3">
                        <label asp-for="Titel" class="sd-input-label">TITEL DER STÖRUNG *</label>
                        <input asp-for="Titel" class="sd-glass-input" placeholder="z. B. Netzwerkdrucker im 3. OG druckt nicht mehr" />
                        <span asp-validation-for="Titel" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="KategorieID" class="sd-input-label">KATEGORIE *</label>
                            <select asp-for="KategorieID" class="sd-glass-input" asp-items="ViewBag.Kategorien">
                                <option value="">– Bitte Kategorie wählen –</option>
                            </select>
                            <span asp-validation-for="KategorieID" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="MitarbeiterID" class="sd-input-label">ZUSTÄNDIGER MITARBEITER</label>
                            <select asp-for="MitarbeiterID" class="sd-glass-input" asp-items="ViewBag.Mitarbeiter">
                                <option value="">– Noch nicht zugewiesen (Pool) –</option>
                            </select>
                            <span asp-validation-for="MitarbeiterID" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="sd-input-label">PRIORITÄT *</label>
                            <div class="d-flex gap-2">
                                @foreach (var p in Enum.GetValues<TicketPrioritaet>())
                                {
                                    var prioBadge = p switch {
                                        TicketPrioritaet.Hoch => "sd-pill-red",
                                        TicketPrioritaet.Mittel => "sd-pill-amber",
                                        _ => "sd-pill-green"
                                    };
                                    <div class="flex-grow-1 text-center">
                                        <input type="radio" class="btn-check" asp-for="Prioritaet" value="@p" id="prio-@p" />
                                        <label class="sd-glass-input d-block text-center cursor-pointer" for="prio-@p" style="cursor: pointer;">
                                            <span class="sd-pill @prioBadge">@p.Anzeige()</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="Prioritaet" class="text-danger small fw-semibold"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="sd-input-label">STATUS *</label>
                            <div class="d-flex gap-2">
                                @foreach (var s in Enum.GetValues<TicketStatus>())
                                {
                                    var statusBadge = s switch {
                                        TicketStatus.Offen => "sd-pill-blue",
                                        TicketStatus.InBearbeitung => "sd-pill-amber",
                                        _ => "sd-pill-green"
                                    };
                                    <div class="flex-grow-1 text-center">
                                        <input type="radio" class="btn-check" asp-for="Status" value="@s" id="status-@s" />
                                        <label class="sd-glass-input d-block text-center cursor-pointer" for="status-@s" style="cursor: pointer;">
                                            <span class="sd-pill @statusBadge">@s.Anzeige()</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="Status" class="text-danger small fw-semibold"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Beschreibung" class="sd-input-label">PROBLEM- &amp; FEHLERBESCHREIBUNG *</label>
                        <textarea asp-for="Beschreibung" class="sd-glass-input" rows="5"></textarea>
                        <span asp-validation-for="Beschreibung" class="text-danger small fw-semibold"></span>
                    </div>

                    <div class="form-check mb-4 d-flex align-items-start gap-2 p-3 rounded" style="background: rgba(11, 15, 28, 0.5); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <input asp-for="HatNeuGestartet" class="form-check-input mt-1" />
                        <label asp-for="HatNeuGestartet" class="form-check-label small text-secondary">
                            <span class="text-white fw-semibold d-block">Pre-Check Bestätigung</span>
                            Gerät wurde bereits neu gestartet und grundlegende Hardware-Kabelverbindungen wurden geprüft.
                        </label>
                    </div>
                </fieldset>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="sd-btn-outline-action">Abbrechen</a>
                    @if (!gesperrt)
                    {
                        <button type="submit" class="sd-btn-submit-crew">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m5 13 4 4L19 7"/>
                            </svg>
                            Änderungen speichern &rarr;
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
