@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isDashboard = (controller == "Home" && action == "Index") || (controller == "Ticket" && action == "Index");
    bool isTickets = controller == "Ticket" && action != "Index" && action != "Create";
    bool isMitarbeiter = controller == "Mitarbeiter";
    bool isKategorie = controller == "Kategorie";
    bool isAccount = controller == "Account";
}
<!DOCTYPE html>
<html lang="de" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ServiceDesk</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MEH.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Hintergrund-Looping-Video -->
    <video class="sd-bg-video" autoplay muted loop playsinline preload="auto">
        <source src="~/bg-hex.mp4" type="video/mp4" />
    </video>
    <div class="sd-bg-overlay"></div>

    <div class="sd-rahmen">

        <!-- Meta-Zeile -->
        <div class="sd-meta">
            <span>ASP.NET CORE MVC | ROUTE: GET /@controller/@action</span>
            <span>STANDORT DORTMUND · WESTFALEN OFFICE SOLUTIONS</span>
        </div>

        <!-- Hauptnavigation -->
        <header class="sd-header">
            <a class="sd-brand" asp-controller="Ticket" asp-action="Index">
                <span class="sd-brand-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>
                    </svg>
                </span>
                <span>ServiceDesk</span>
            </a>
            <nav class="sd-nav">
                <a class="@(isDashboard ? "sd-nav-link aktiv" : "sd-nav-link")" asp-controller="Ticket" asp-action="Index">Dashboard</a>
                <a class="@(isTickets ? "sd-nav-link aktiv" : "sd-nav-link")" asp-controller="Ticket" asp-action="Index">Tickets</a>
                <a class="@(isMitarbeiter ? "sd-nav-link aktiv" : "sd-nav-link")" asp-controller="Mitarbeiter" asp-action="Index">Mitarbeiter</a>
                <a class="@(isKategorie ? "sd-nav-link aktiv" : "sd-nav-link")" asp-controller="Kategorie" asp-action="Index">Kategorien</a>
            </nav>

            <div class="d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="sd-nav-link text-white d-flex align-items-center gap-2" style="background: transparent; border-right: 1px solid var(--sd-linie);">
                        <span class="sd-mini-dot"></span>
                        <span class="small font-monospace text-info">@User.Identity.Name</span>
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sd-nav-link border-0 text-muted" style="background: transparent; border-right: 1px solid var(--sd-linie); cursor: pointer;" title="Abmelden">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                        </button>
                    </form>
                }
                else
                {
                    <a class="@(isAccount ? "sd-nav-link aktiv" : "sd-nav-link")" asp-controller="Account" asp-action="Login">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        Login
                    </a>
                }
                <a class="sd-melden" asp-controller="Ticket" asp-action="Create">+ Neues Ticket</a>
            </div>
        </header>

        <main role="main" class="sd-main">
            @if (TempData["Erfolg"] is string erfolg)
            {
                <div class="sd-flash sd-flash-ok">✓ @erfolg</div>
            }
            @if (TempData["Fehler"] is string fehler)
            {
                <div class="sd-flash sd-flash-fehler">■ @fehler</div>
            }
            @RenderBody()
        </main>

        <footer class="sd-footer">
            <span>WOS / DORTMUND · INTERN. NÜCHTERN. NACHVOLLZIEHBAR.</span>
            <span>&copy; @DateTime.Now.Year SERVICEDESK · <a asp-controller="Home" asp-action="Privacy">DATENSCHUTZ</a></span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
