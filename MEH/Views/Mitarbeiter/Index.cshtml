@model IEnumerable<MEH.Models.Mitarbeiter>
@using MEH.Models

@{
    ViewData["Title"] = "Mitarbeiter // IT-Crew";

    int totalCrew = Model.Count();
    int activeAssignments = Model.Sum(m => m.Tickets.Count(t => t.Status != TicketStatus.Schluss));
}

<!-- TOP PAGE TITLE & STATS STRIP -->
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <div class="sd-squad-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            TEAM MANAGEMENT
        </div>
        <h1 class="sd-hero-titel mb-1">IT-Support Squad &amp; Zuständigkeiten</h1>
        <p class="sd-hero-unter mb-0">
            <strong>@totalCrew Techniker</strong> im aktiven Einsatz &nbsp;&middot;&nbsp; 
            <strong>@activeAssignments offene Zuweisungen</strong> &nbsp;&middot;&nbsp; 
            <span class="text-success fw-semibold">0 verwaiste Tickets</span>
        </p>
    </div>

    <!-- FILTER / SEARCH BAR -->
    <div class="sd-squad-search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sd-search-icon">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="crewSearchInput" placeholder="Techniker nach Fachbereich oder Name filtern..." onkeyup="filterCrewCards()" />
        <span class="sd-search-badge">⌘K</span>
    </div>
</div>

<!-- SUBTITLE & ONLINE STATUS -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="fw-bold text-white fs-5">Aktive Crew</span>
        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25 py-1 px-2 font-monospace" style="font-size: 0.72rem;">LIVE ROSTER</span>
    </div>
    <div class="small font-monospace text-muted d-flex align-items-center gap-2">
        <span class="sd-dot-pulse"></span>
        <span class="text-success fw-semibold">@totalCrew VON @totalCrew ONLINE</span>
    </div>
</div>

<!-- TWO-COLUMN ASYMMETRIC GRID: CREW CARDS (LEFT 65%) + REGISTER FORM (RIGHT 35%) -->
<div class="row g-4">

    <!-- LEFT: CREW ROSTER CARDS -->
    <div class="col-12 col-lg-7 col-xl-8">
        <div class="row g-3" id="crewCardsContainer">
            @foreach (var item in Model)
            {
                var initials = $"{item.Vorname?.FirstOrDefault()}{item.Nachname?.FirstOrDefault()}".ToUpper();
                if (string.IsNullOrWhiteSpace(initials)) { initials = "IT"; }

                var openTickets = item.Tickets.Count(t => t.Status != TicketStatus.Schluss);
                // Lastberechnung (z.B. max 5 Tickets = 100%)
                var loadPercent = Math.Min(100, openTickets * 20);
                var isHeavyLoad = loadPercent >= 75;

                <div class="col-12 col-md-6 crew-card-wrapper" data-name="@item.Name.ToLower()" data-dept="@item.Fachbereich?.ToLower()">
                    <div class="sd-crew-card">
                        
                        <!-- CARD TOP: AVATAR & NAME -->
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-3">
                                <div class="sd-crew-avatar">
                                    @initials
                                </div>
                                <div>
                                    <div class="sd-crew-status">
                                        <span class="sd-mini-dot"></span> IM DIENST
                                    </div>
                                    <h3 class="sd-crew-name">@item.Name</h3>
                                    <div class="sd-crew-dept">@item.Fachbereich</div>
                                </div>
                            </div>
                            <div class="dropdown">
                                <a asp-action="Delete" asp-route-id="@item.ID" class="sd-icon-btn text-muted" title="Löschen">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <!-- BADGE & TECH-ID -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <span class="sd-dept-chip">[ @(string.IsNullOrWhiteSpace(item.Fachbereich) ? "Support" : item.Fachbereich) ]</span>
                            <span class="sd-tech-id">TECH-@initials</span>
                        </div>

                        <!-- WORKLOAD PROGRESS BAR -->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1 small">
                                <span class="text-secondary" style="font-size: 0.8rem;">
                                    @openTickets Aktive@(openTickets == 1 ? "s" : "") Ticket@(openTickets == 1 ? "" : "s") (@(loadPercent)% Last)
                                </span>
                                <span class="font-monospace fw-semibold @(isHeavyLoad ? "text-danger" : "text-info")" style="font-size: 0.78rem;">
                                    @(loadPercent)%
                                </span>
                            </div>
                            <div class="sd-progress-track">
                                <div class="sd-progress-fill @(isHeavyLoad ? "bg-danger" : "bg-info")" style="width: @(loadPercent)%;"></div>
                            </div>
                        </div>

                        <!-- CARD FOOTER BUTTONS -->
                        <div class="d-flex gap-2 mt-4 pt-1">
                            <a asp-action="Edit" asp-route-id="@item.ID" class="sd-btn-outline-action flex-grow-0">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Bearbeiten
                            </a>
                            <a asp-controller="Ticket" asp-action="Index" class="sd-btn-view-assignments flex-grow-1">
                                Zuweisungen ansehen &rarr;
                            </a>
                        </div>

                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="sd-crew-card text-center py-5 text-secondary">
                        Bislang sind noch keine Mitarbeiter angelegt. Nutzen Sie das Formular rechts zur Registrierung.
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT: QUICK REGISTRATION FORM (MATCHING FIGMA CARD) -->
    <div class="col-12 col-lg-5 col-xl-4">
        <div class="sd-join-card">
            
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="sd-join-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </div>
                <div>
                    <div class="sd-join-kicker">TEAM ERWEITERN</div>
                    <h2 class="sd-join-title mb-0">Neuer Team-Zugang</h2>
                </div>
            </div>

            <p class="sd-join-text mb-4">
                Lege ein neues Crew-Profil an und aktiviere den Zugang zum Ticket-Routing.
            </p>

            <form asp-action="Create" method="post">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="sd-input-label" for="form-vorname">VORNAME</label>
                        <input class="sd-glass-input" id="form-vorname" name="Vorname" placeholder="z. B. Lena" required />
                    </div>
                    <div class="col-6">
                        <label class="sd-input-label" for="form-nachname">NACHNAME</label>
                        <input class="sd-glass-input" id="form-nachname" name="Nachname" placeholder="z. B. Weber" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="sd-input-label" for="form-email">E-MAIL-ADRESSE</label>
                    <input class="sd-glass-input" id="form-email" name="Email" type="email" placeholder="lena.weber@servicedesk.de" required />
                </div>

                <div class="mb-3">
                    <label class="sd-input-label" for="form-fachbereich">FACHBEREICH / SPEZIALISIERUNG</label>
                    <select class="sd-glass-input" id="form-fachbereich" name="Fachbereich" required>
                        <option value="">Fachbereich wählen</option>
                        <option value="Hardware &amp; Core">Hardware &amp; Core</option>
                        <option value="Netzwerk &amp; Infrastruktur">Netzwerk &amp; Infrastruktur</option>
                        <option value="Software &amp; Cloud Services">Software &amp; Cloud Services</option>
                        <option value="Berechtigungen &amp; AD">Berechtigungen &amp; AD</option>
                        <option value="First-Level Helpdesk">First-Level Helpdesk</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="sd-input-label" for="form-password">PASSWORT</label>
                    <input class="sd-glass-input" id="form-password" name="Password" type="password" placeholder="••••••••" required />
                </div>

                <div class="form-check mb-4 d-flex align-items-start gap-2">
                    <input class="form-check-input mt-1" type="checkbox" id="checkRouting" checked />
                    <label class="form-check-label small text-secondary" for="checkRouting">
                        <span class="text-white fw-semibold d-block">Sofort für Ticket-Routing aktivieren</span>
                        Neue Zuweisungen automatisch verteilen
                    </label>
                </div>

                <button type="submit" class="sd-btn-submit-crew w-100">
                    Mitarbeiter registrieren &rarr;
                </button>
            </form>

            <!-- LÖSCHSCHUTZ / REFERENZSCHUTZ INFO BOX -->
            <div class="sd-ref-shield mt-4">
                <div class="sd-shield-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <div class="small">
                    <div class="fw-bold text-white mb-1">1:n Schutzregel</div>
                    <div class="text-secondary" style="font-size: 0.8rem; line-height: 1.4;">
                        Mitarbeiter mit zugewiesenen Tickets können nicht gelöscht werden, um Ticketverlust zu verhindern.
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- QUICK JS CLIENT-SIDE SEARCH / FILTER -->
<script>
    function filterCrewCards() {
        const query = document.getElementById('crewSearchInput').value.toLowerCase();
        const cards = document.querySelectorAll('.crew-card-wrapper');
        cards.forEach(card => {
            const name = card.getAttribute('data-name') || '';
            const dept = card.getAttribute('data-dept') || '';
            if (name.includes(query) || dept.includes(query)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>
