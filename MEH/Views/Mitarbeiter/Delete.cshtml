@model MEH.Models.Mitarbeiter

@{
    ViewData["Title"] = "Mitarbeiter löschen";
}

<div class="sd-kopf">
    <div>
        <div class="sd-label">Seite 04 // #EMP-@Model.ID.ToString("00")</div>
        <h1 class="sd-seiten-titel">Mitarbeiter <em>löschen?</em></h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">&lt; Zurück zur Übersicht</a>
</div>

<div class="sd-formular">
    <div class="sd-hinweis mb-4">
        <div class="sd-label sd-label-akzent">■ Datenbank-Regel // 1:n Referenzschutz</div>
        <p class="mb-0 mt-2">Mitarbeiter mit zugewiesenen Tickets können nicht gelöscht werden.
            @if (Model.Tickets.Any())
            {
                <br /><strong>Diesem Mitarbeiter sind noch @Model.Tickets.Count Ticket(s) zugewiesen – das Löschen wird abgelehnt.</strong>
            }
        </p>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Vorname @Model.Nachname</dd>
        <dt class="col-sm-3">E-Mail</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Fachbereich</dt>
        <dd class="col-sm-9">@Model.Fachbereich</dd>
    </dl>

    <form asp-action="Delete" class="sd-formular-aktionen">
        <input type="hidden" asp-for="ID" />
        <a asp-action="Index" class="btn btn-outline-dark">Abbrechen</a>
        <button type="submit" class="btn btn-dark">Endgültig löschen</button>
    </form>
</div>
