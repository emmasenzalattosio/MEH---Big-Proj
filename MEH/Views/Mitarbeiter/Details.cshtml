@model MEH.Models.Mitarbeiter

@{
    ViewData["Title"] = "Mitarbeiter – Details";
}

<div class="sd-kopf">
    <div>
        <div class="sd-label">Seite 04 // #EMP-@Model.ID.ToString("00")</div>
        <h1 class="sd-seiten-titel">@Model.Vorname @Model.Nachname</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-dark">&lt; Zurück zur Übersicht</a>
</div>

<div class="sd-formular">
    <dl class="row">
        <dt class="col-sm-3">Vorname</dt>
        <dd class="col-sm-9">@Model.Vorname</dd>
        <dt class="col-sm-3">Nachname</dt>
        <dd class="col-sm-9">@Model.Nachname</dd>
        <dt class="col-sm-3">E-Mail</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Fachbereich</dt>
        <dd class="col-sm-9">@Model.Fachbereich</dd>
    </dl>

    <div class="sd-formular-aktionen">
        <a asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-outline-dark">Löschen</a>
        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-dark">Bearbeiten &gt;</a>
    </div>
</div>
